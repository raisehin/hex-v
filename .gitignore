# Local-only build entry point. Use build-github.ps1 for clean builds.
/build.ps1

# Local-only benchmark policy/notes. Never commit benchmark output.
/benchmarks.md

# Local-only lean comparison workspace: only build sources are trackable.
/lean comparison/*
!/lean comparison/lean-toolchain
!/lean comparison/lakefile.lean
!/lean comparison/lake-manifest.json
!/lean comparison/DotScope.lean
!/lean comparison/Replay.lean
!/lean comparison/Main.lean
!/lean comparison/Verify.lean
!/lean comparison/Tests.lean
/lean comparison/.lake/
/lean comparison/out/

# Build output
/v/bin/

# Generated reference frames and dumps
/v/out/
/v/out/frames/
/v/out/*.bin
/oracle/out/
/oracle/target/
*.uniform.bin
frames.bin
dots.bin

# The oracle is reference material, not a compile input.
/oracle/

# Runtime state and dependencies
*.log
/models/
models/
*.gguf
*.dll

# Subagent review artifacts (normally outside the repo under ~/.pi)
subagent-artifacts/

# Editor / OS junk
.DS_Store
Thumbs.db
*.pdb
*.ilk
*.obj
